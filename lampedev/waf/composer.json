{
  "name": "lampedev/waf",
  "description": "Professional Laravel Web Application Firewall (WAF) by Lampedev",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Lampedev",
      "email": "dev@lampedev.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "illuminate/support": "^9.0|^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Lampedev\\Waf\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Lampedev\\Waf\\WafServiceProvider"
      ],
      "aliases": {
        "Waf": "Lampedev\\Waf\\Facades\\Waf"
      }
    }
  }
}